{
  "manifest_version": 3,
  "name": "CueCast Runner Focus Helper",
  "version": "0.1.0",
  "description": "Best-effort foreground focus helper for headed Playwright runner windows.",
  "permissions": ["tabs", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
