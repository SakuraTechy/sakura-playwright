# CueCast Playwright Runner 环境变量模板。
# 复制本文件为 playwright-runner/.env，并按当前环境调整配置值。

# Runner 读取测试用例和上报执行结果使用的 API 地址。
CUECAST_API_BASE=http://127.0.0.1:4173/api

# 可选 API token。不要提交真实 token。
CUECAST_TOKEN=

# 单用例和批量执行的默认用例配置。命令行参数仍然拥有最高优先级。
CUECAST_CASE_ID=278
CUECAST_CASE_IDS=278,279

# 浏览器和运行时配置。
RUNNER_BROWSER=chromium
RUNNER_HEADED=false
RUNNER_WORKERS=1
RUNNER_STEP_TIMEOUT_MS=6000
RUNNER_CASE_TIMEOUT_MS=600000

# 执行产物保留配置。
RUNNER_ARTIFACT_DIR=playwright-runner/artifacts
RUNNER_TRACE=retain-on-failure
RUNNER_VIDEO=retain-on-failure

# 有头模式观察配置。
RUNNER_SLOW_MO_MS=0
RUNNER_FINISH_DELAY_MS=0

# 可选登录态或会话状态文件，用于 Runner 或导出脚本复用登录状态。
CUECAST_STORAGE_STATE=
RUNNER_STORAGE_STATE=
