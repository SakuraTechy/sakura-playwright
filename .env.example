# Sakura Playwright 环境变量模板；复制为仓库根目录的 .env 后按部署环境调整。
# 命令行参数优先于本文件，不要在模板或仓库中提交真实 token。

# Runner 读取 admin 用例和上报执行结果的 Spring API 直连地址，不要添加前端代理前缀 /api。
CUECAST_API_BASE=http://127.0.0.1:8000
# 是否使用 admin 用例读取和结果回传协议；平台回放设为 true，test-lab 可显式传 --admin-api false。
CUECAST_ADMIN_API=true
# 可选 API 访问令牌；平台回放由 admin 按任务临时注入，本地文件不要保存或提交真实令牌。
CUECAST_TOKEN=
# 外部独立 Runner 使用“应用管理”创建的 Access Key/Secret Key；与 CUECAST_TOKEN 二选一。
SAKURA_ADMIN_ACCESS_KEY=
SAKURA_ADMIN_SECRET_KEY=
# Admin 为单次执行返回的短期 execution capability；不要持久化真实值。
CUECAST_EXECUTION_CAPABILITY=
# 直接运行单用例且未传 --case-id 时使用的默认 case ID。
CUECAST_CASE_ID=278
# 平台单次回放由 admin 注入产品环境 ID，本地直连 admin 时可临时填写。
CUECAST_PROJECT_ENVIRONMENT_ID=
# Admin 托管模式由 Admin 自动注入；外部独立 Runner 才需要手动设置稳定实例标识。
SAKURA_PLAYWRIGHT_EXECUTOR_INSTANCE_ID=
# 批量回放且未传 --case-ids 时使用的默认 case ID 列表，多个值用英文逗号分隔。
CUECAST_CASE_IDS=278,279
# CueCast/导出脚本可选登录态文件路径；留空表示不复用登录状态。
CUECAST_STORAGE_STATE=


# 回放使用的浏览器，可选 chromium、firefox、webkit。
RUNNER_BROWSER=chromium
# 可选浏览器可执行文件绝对路径；Playwright 浏览器无法下载时可指向节点已安装且与 RUNNER_BROWSER 匹配的浏览器。
RUNNER_BROWSER_EXECUTABLE_PATH=
# 定位执行模式；legacy 保持历史 CLI/Jenkins 行为，admin Runner Job 会显式传 semantic-v1。
RUNNER_LOCATOR_MODE=legacy
# 页面错误检测任务级覆盖；留空继承用例 page_error_check_enabled，true/false 表示显式覆盖。
RUNNER_PAGE_ERROR_CHECK_ENABLED=
# 是否生成统一 details.operation 摘要；关闭时保留旧步骤结果和 typed facets。
RUNNER_OPERATION_DIAGNOSTIC_ENABLED=true
# 实时画面质量兜底档位，可选 smooth、high、ultra、8k；平台任务下拉选项优先于此配置。
RUNNER_LIVE_FRAME_QUALITY=smooth
# 是否显示浏览器窗口；本地观察可设为 true，后台服务或 Jenkins 节点建议设为 false。
RUNNER_HEADED=false
# 是否忽略 HTTPS 证书错误；仅内部自签名证书测试站点设为 true，公网生产环境应设为 false。
RUNNER_IGNORE_HTTPS_ERRORS=true
# 批量回放的并行 worker 数量；单用例平台回放不使用此项。
RUNNER_WORKERS=1
# 用例会话模式；isolated 保持隔离，reuse-auth 复用认证状态，reuse-browser 复用同一浏览器窗口；后两者仅支持 workers=1。
RUNNER_SESSION_MODE=isolated
# 单步骤及初始页面导航的超时时间，单位毫秒。
RUNNER_STEP_TIMEOUT_MS=6000
# 单个用例允许执行的最长时间，单位毫秒。
RUNNER_CASE_TIMEOUT_MS=600000
# 截图、日志、trace、video 和结果文件的产物根目录；相对路径基于 sakura-playwright 仓库根目录解析。
RUNNER_ARTIFACT_DIR=artifacts
# Runner 本机结构化诊断日志目录；仅记录状态数量和流程决策，不记录 Cookie、Token 或认证值。
RUNNER_LOG_DIR=logs
# 平台模式下仅清理已完成上传和结果回传的本地历史目录；独立 CLI/Jenkins 模式不受此策略影响。
RUNNER_LOCAL_ARTIFACT_CLEANUP_ENABLED=true
# 成功执行本地产物保留时长（小时）。
RUNNER_LOCAL_ARTIFACT_SUCCESS_RETENTION_HOURS=24
# 失败但已完成上传和回传的本地产物保留时长（天）。
RUNNER_LOCAL_ARTIFACT_FAILURE_RETENTION_DAYS=7
# Trace 保留策略，可选 off、on、retain-on-failure；推荐仅失败时保留。
RUNNER_TRACE=retain-on-failure
# 视频保留策略，可选 off、on、retain-on-failure；推荐仅失败时保留。
RUNNER_VIDEO=retain-on-failure
# Playwright 动作慢放时间，单位毫秒；仅用于有头模式人工观察，0 表示不慢放。
RUNNER_SLOW_MO_MS=0
# 用例结束后关闭浏览器前的停留时间，单位毫秒；0 表示立即关闭。
RUNNER_FINISH_DELAY_MS=0
# Runner/导出脚本可选初始登录态文件路径；Runner 只读取源文件，不会覆盖它。
RUNNER_STORAGE_STATE=
